10111111 00000000 01000001 00000000 00000000 # instruction | MOV EDI,4100 | Start the three-entry native frame log.
10111011 00000011 00000000 00000000 00000000 # instruction | MOV EBX,3 | Accept exactly three IRQ entries; the control changes byte 77 bit zero to two.
10111001 00001100 00000000 00000000 00000000 # instruction | MOV ECX,12 | Clear twelve log doublewords.
00110001 11000000 # instruction | XOR EAX,EAX | Prepare the log's zero value.
10001001 00000111 # instruction | MOV [EDI],EAX | Initialize one doubleword of the log.
10000011 11000111 00000100 # instruction | ADD EDI,4 | Advance within the 48-byte log.
11100010 11111001 # instruction | LOOP -7 | Repeat at offset 88 until all three entries are zero.
10111111 00000000 01000001 00000000 00000000 # instruction | MOV EDI,4100 | Reset the handler-owned log cursor.
11000110 00000101 11111111 01000000 00000000 00000000 10100101 # instruction | MOV byte [40FF],A5 | Guard the byte before the log.
11000110 00000101 00110000 01000001 00000000 00000000 01011010 # instruction | MOV byte [4130],5A | Guard the byte after the third entry.
10110000 00010001 # instruction | MOV AL,11 | Start edge-triggered cascaded PIC initialization, requesting ICW4.
11100110 00100000 # instruction | OUT 20,AL | Initialize the master PIC command register.
11100110 10100000 # instruction | OUT A0,AL | Initialize the slave PIC command register.
10110000 00100000 # instruction | MOV AL,20 | Map master IRQ0 through IRQ7 to vectors 20 through 27.
11100110 00100001 # instruction | OUT 21,AL | Write master ICW2.
10110000 00101000 # instruction | MOV AL,28 | Map slave IRQs to vectors 28 through 2F.
11100110 10100001 # instruction | OUT A1,AL | Write slave ICW2.
10110000 00000100 # instruction | MOV AL,04 | Declare the slave on master IRQ2.
11100110 00100001 # instruction | OUT 21,AL | Write master ICW3.
10110000 00000010 # instruction | MOV AL,02 | Identify the slave's cascade input.
11100110 10100001 # instruction | OUT A1,AL | Write slave ICW3.
10110000 00000001 # instruction | MOV AL,01 | Select 8086 mode with explicit EOI, not automatic EOI.
11100110 00100001 # instruction | OUT 21,AL | Write master ICW4.
11100110 10100001 # instruction | OUT A1,AL | Write slave ICW4.
10110000 11111111 # instruction | MOV AL,FF | Keep every slave IRQ masked.
11100110 10100001 # instruction | OUT A1,AL | Install the slave mask.
10110000 00110110 # instruction | MOV AL,36 | PIT counter zero, low then high byte, binary mode three.
11100110 01000011 # instruction | OUT 43,AL | Program the PIT control word.
10110000 10011100 # instruction | MOV AL,9C | Low byte of the literal reload value 2E9C.
11100110 01000000 # instruction | OUT 40,AL | Write counter zero's low reload byte first.
10110000 00101110 # instruction | MOV AL,2E | High reload byte; no measured timing claim.
11100110 01000000 # instruction | OUT 40,AL | Complete counter zero's reload.
10110000 11111110 # instruction | MOV AL,FE | Unmask only master IRQ0.
11100110 00100001 # instruction | OUT 21,AL | Install the master mask while CPU IF is still zero.
11111010 # instruction | CLI | Begin the wait loop with interrupts masked, preventing a check-to-HLT race.
00111001 00011101 00000000 01000000 00000000 00000000 # instruction | CMP [4000],EBX | Compare the completed native count with the literal limit.
01110011 00000100 # instruction | JAE +4 | Skip STI, wait HLT and the loop jump when the count has reached its limit.
11111011 # instruction | STI | Enable delivery; the following HLT is inside the architectural interrupt shadow.
11110100 # instruction | HLT wait | Wait for a real emulated device interrupt, not a software INT instruction.
11101011 11110011 # instruction | JMP -13 | Recheck the count with CLI at offset 162 after returning.
11110100 # instruction | HLT done | Finish with IF zero and the timer line masked.
11101011 11111101 # instruction | JMP -3 | Return to the final halt if resumed.
