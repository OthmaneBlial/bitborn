11101000 00101110 00000000 # instruction | CALL puts | E8; next offset 201 + 46 = 247.
10100000 00000000 01111100 # instruction | MOV AL,[7C00] | A0 moffs16 loads the real first byte of the boot sector from memory, not a hardcoded answer.
11101000 01010111 00000000 # instruction | CALL hex | E8; next offset 207 + 87 = byte-to-hex at 294.
10111110 01010011 01111111 # instruction | MOV SI,7F53 | BE loads the newline string.
