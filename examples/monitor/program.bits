# 16-bit monitor second stage. boot/loader.bits loads this at 0000:7E00.
# Literal operands below were calculated by hand; comments are explanatory only.
10111000 00000011 00000000 # instruction | MOV AX,0003 | B8 selects BIOS VGA text mode.
11001101 00010000 # instruction | INT 10 | CD 10 clears and configures the display.
10111010 11111001 00000011 # instruction | MOV DX,03F9 | BA selects UART interrupt-enable port.
10110000 00000000 # instruction | MOV AL,00 | B0 disables serial interrupts.
11101110 # instruction | OUT DX,AL | EE writes UART interrupt enable.
10111010 11111011 00000011 # instruction | MOV DX,03FB | BA selects UART line control.
10110000 10000000 # instruction | MOV AL,80 | B0 enables divisor latch.
11101110 # instruction | OUT DX,AL | EE sets DLAB.
10111010 11111000 00000011 # instruction | MOV DX,03F8 | BA selects divisor low-byte register.
10110000 00000001 # instruction | MOV AL,01 | B0 sets divisor one, 115200 baud.
11101110 # instruction | OUT DX,AL | EE writes divisor low byte.
01000010 # instruction | INC DX | 42 advances to divisor high-byte port.
10110000 00000000 # instruction | MOV AL,00 | B0 clears divisor high byte.
11101110 # instruction | OUT DX,AL | EE writes divisor high byte.
10111010 11111011 00000011 # instruction | MOV DX,03FB | BA selects UART line control again.
10110000 00000011 # instruction | MOV AL,03 | B0 selects 8N1, clearing divisor access.
11101110 # instruction | OUT DX,AL | EE configures UART framing.
10111110 00111110 01111111 # instruction | MOV SI,7F3E | BE loads welcome text at stage offset 318.
11101000 11010000 00000000 # instruction | CALL puts | E8 rel16; next offset 39 + 208 = puts at 247.
