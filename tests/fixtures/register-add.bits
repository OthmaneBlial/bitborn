00000011 11001010 # instruction | ADD CX,DX | Signed overflow without unsigned carry.
10001001 00001110 00000100 00100010 # instruction | MOV [2204],CX | Store the result.
10011100 # instruction | PUSHF | Capture the native status flags.
01011011 # instruction | POP BX | Balance the stack.
10001001 00011110 00000110 00100010 # instruction | MOV [2206],BX | Store native flags.
10111011 00000000 10000000 # instruction | MOV BX,8000 | Signed minimum.
10111101 00000000 10000000 # instruction | MOV BP,8000 | Add the same signed minimum.
00000001 11101011 # instruction | ADD BX,BP | Both unsigned carry and signed overflow.
10001001 00011110 00001000 00100010 # instruction | MOV [2208],BX | Store zero.
10011100 # instruction | PUSHF | Capture the real flags.
01011000 # instruction | POP AX | Restore the call-free stack.
10100011 00001010 00100010 # instruction | MOV [220A],AX | Store flags.
10111110 00001111 00000000 # instruction | MOV SI,000F | Low-nibble boundary.
10111111 00000001 00000000 # instruction | MOV DI,1 | Add one to the index register.
